# ---- Core ----
VOICEDESK_ENV=development
API_PORT=3010
DASHBOARD_PORT=3011
LOG_LEVEL=INFO

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://voicedesk:voicedesk@localhost:5435/voicedesk
DATABASE_URL_SYNC=postgresql+psycopg://voicedesk:voicedesk@localhost:5435/voicedesk

# ---- Redis ----
REDIS_URL=redis://localhost:6381/0

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
WEBHOOK_HMAC_SECRET=change-me-webhook-secret
RECORDING_ENCRYPTION_KEY=

# ---- CORS ----
CORS_ORIGINS=http://localhost:3011,http://127.0.0.1:3011

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=100

# ---- OpenRouter (LLM) ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated fallback chain of FREE models, tried in order
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen-2.5-72b-instruct:free,google/gemma-2-9b-it:free
OPENROUTER_TIMEOUT_SECONDS=20
OPENROUTER_APP_URL=https://voicedesk.apprend.tech
OPENROUTER_APP_NAME=VoiceDesk

# ---- Telephony ----
# exotel | knowlarity | mock
TELEPHONY_PROVIDER=mock
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
KNOWLARITY_API_KEY=
KNOWLARITY_SR_NUMBER=
TELEPHONY_CALLBACK_BASE_URL=http://localhost:3010

# ---- Object storage (call recordings) ----
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=voicedesk
S3_SECRET_KEY=voicedesk123
S3_BUCKET=voicedesk-recordings
S3_REGION=ap-south-1
RECORDING_RETENTION_DAYS=90

# ---- WhatsApp handoff ----
# gosumo | mock
WHATSAPP_PROVIDER=mock
GOSUMO_API_URL=https://api.gosumo.io/v1
GOSUMO_API_KEY=
WHATSAPP_HANDOFF_CONFIDENCE_THRESHOLD=0.70

# ---- TRAI compliance ----
TRAI_CALLING_HOUR_START=9
TRAI_CALLING_HOUR_END=21
TRAI_TIMEZONE=Asia/Kolkata
TRAI_DND_CHECK_ENABLED=true
TRAI_RECORDING_CONSENT_ENABLED=true

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:3010
